# Адрес, по которому сайт открыт снаружи.
#
# Нужен только для метаданных: картинка превью в мессенджерах, canonical,
# sitemap.xml, robots.txt. На то, как работает сам сайт, не влияет.
#
# Пока домена нет — можно ничего не создавать: в коде подставится
# http://localhost:3000 (см. src/lib/site.ts).
#
# Когда домен появится: скопировать этот файл в .env.local, вписать адрес,
# пересобрать (npm run build).
NEXT_PUBLIC_SITE_URL=https://example.com

# Адрес API в примерах документации и на главной.
#
# По умолчанию — тот же сайт с префиксом /api: Next проксирует /api/v1/*
# на шлюз, поэтому примеры работают как есть. Задавать, только если API
# переедет на отдельный поддомен, например https://api.ваш-домен.
# NEXT_PUBLIC_API_BASE=https://api.example.com
